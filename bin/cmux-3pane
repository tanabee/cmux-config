#!/usr/bin/env bash
set -euo pipefail

if [[ -z "${CMUX_SURFACE_ID:-}" ]]; then
  echo "cmux-3pane: must be run from inside a cmux terminal (CMUX_SURFACE_ID not set)" >&2
  exit 1
fi

origin_surface="$CMUX_SURFACE_ID"

cmux new-split down >/dev/null
cmux focus-panel --panel "$origin_surface"
cmux new-split right >/dev/null
